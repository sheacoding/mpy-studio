{
    "compilerOptions": {
      "module": "commonjs",
      "target": "es2023",
      "outDir": "out",
      "lib": ["es2023"],
      "sourceMap": true,
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "types": ["node", "vscode"],
      "moduleResolution": "node",
      "allowSyntheticDefaultImports": true,
      "resolveJsonModule": true
    },
    "include": [
      "src/**/*"
    ],
    "exclude": ["node_modules"]
  }