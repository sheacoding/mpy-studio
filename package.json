{
  "name": "mpy-studio",
  "displayName": "mpy-studio",
  "description": "A comprehensive MicroPython IDE for ESP32 and ESP32-S3 development boards. Features device management, code execution, REPL terminal, and more.",
  "version": "1.0.5",
  "publisher": "bright",
  "engines": {
    "vscode": "^1.92.0",
    "node": ">=22.12.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onFileSystem:micropython"
  ],
  "contributes": {
    "commands": [
      {
        "command": "extension.mpyMenu",
        "title": "MicroPython",
        "icon": {
          "light": "media/light/micropython-menu.svg",
          "dark": "media/dark/micropython-menu.svg"
        }
      },
      {
        "command": "extension.mpyRUN",
        "title": "运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "extension.mpyStop",
        "title": "停止当前程序",
        "icon": "$(debug-stop)"
      },
      {
        "command": "extension.mpyREPL",
        "title": "REPL终端",
        "icon": "$(terminal)"
      },
      {
        "command": "extension.mpyMAIN",
        "title": "上传为主程序",
        "icon": "$(arrow-up)"
      },
      {
        "command": "extension.mpyHardReset",
        "title": "硬重启设备",
        "icon": "$(debug-restart)"
      },
      {
        "command": "extension.mpySelectPort",
        "title": "选择串口",
        "icon": "$(plug)"
      },
      {
        "command": "extension.mpyDisconnect",
        "title": "断开连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "extension.mpyShowLogs",
        "title": "显示插件日志",
        "icon": "$(output)"
      },
      {
        "command": "extension.mpyClear",
        "title": "清除主程序",
        "icon": "$(clear-all)"
      },
      {
        "command": "extension.updateTypings",
        "title": "更新 MicroPython 类型定义",
        "icon": "$(sync)"
      },
      {
        "command": "extension.selectBoard",
        "title": "选择开发板",
        "icon": "$(device-desktop)"
      },
      {
        "command": "extension.switchRunMode",
        "title": "切换运行模式"
      },
      {
        "command": "extension.mpyDeviceFolder",
        "title": "设备文件夹",
        "icon": "$(folder)"
      },
      {
        "command": "mpy-studio.openFile",
        "title": "打开文件"
      },
      {
        "command": "mpy-studio.copyFile",
        "title": "复制"
      },
      {
        "command": "mpy-studio.cutFile",
        "title": "剪切"
      },
      {
        "command": "mpy-studio.pasteFile",
        "title": "粘贴"
      },
      {
        "command": "mpy-studio.deleteFile",
        "title": "删除"
      },
      {
        "command": "mpy-studio.refreshDevice",
        "title": "刷新设备目录",
        "icon": {
          "light": "media/refresh.svg",
          "dark": "media/refresh.svg"
        }
      },
      {
        "command": "mpy-studio.createFile",
        "title": "新建文件",
        "icon": {
          "light": "media/new-file.svg",
          "dark": "media/new-file.svg"
        }
      },
      {
        "command": "mpy-studio.createFolder",
        "title": "新建文件夹",
        "icon": {
          "light": "media/new-folder.svg",
          "dark": "media/new-folder.svg"
        }
      },
      {
        "command": "mpy-studio.refresh",
        "title": "刷新"
      },
      {
        "command": "mpy-studio.uploadFile",
        "title": "[mpy-studio]-上传到设备"
      },
      {
        "command": "mpy-studio.runOnDevice",
        "title": "[mpy-studio]-在设备上运行"
      },
      {
        "command": "mpy-studio.downloadFile",
        "title": "下载到本地"
      },
      {
        "command": "mpy-studio.uploadToDevice",
        "title": "[mpy-studio]-上传到设备"
      }
    ],
    "submenus": [
      {
        "id": "micropythonMenu.submenu",
        "label": "MicroPython菜单",
        "icon": {
          "light": "media/light/micropython-menu.svg",
          "dark": "media/dark/micropython-menu.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "micropythonMenu.submenu",
          "group": "navigation@4",
          "when": "resourceLangId == python"
        }
      ],
      "micropythonMenu.submenu": [
        {
          "command": "extension.mpyRUN",
          "group": "1_run@1",
          "icon": "$(play)"
        },
        {
          "command": "extension.mpyStop",
          "group": "1_run@2",
          "icon": "$(debug-stop)"
        },
        {
          "command": "extension.mpyClear",
          "group": "1_run@3",
          "icon": "$(clear-all)"
        },
        {
          "command": "extension.mpyMAIN",
          "group": "1_run@4",
          "icon": "$(arrow-up)"
        },
        {
          "command": "extension.mpyREPL",
          "group": "2_device",
          "icon": "$(terminal)"
        },
        {
          "command": "extension.mpyDeviceFolder",
          "group": "2_device@2",
          "icon": "$(folder)"
        },
        {
          "command": "extension.mpyHardReset",
          "group": "2_device@3",
          "icon": "$(debug-restart)"
        },
        {
          "command": "extension.mpyDisconnect",
          "group": "4_manage",
          "icon": "$(debug-disconnect)"
        },
        {
          "command": "extension.mpyShowLogs",
          "group": "4_manage",
          "icon": "$(output)"
        }
      ],
      "explorer/context": [
        {
          "command": "mpy-studio.uploadToDevice",
          "group": "navigation",
          "when": "mpyStudio.deviceConnected"
        },
        {
          "command": "mpy-studio.runOnDevice",
          "group": "navigation",
          "when": "resourceExtname == .py"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.mpyMenu",
          "when": "resourceLangId == python"
        },
        {
          "command": "extension.mpyREPL",
          "when": "resourceLangId == python"
        }
      ],
      "view/item/context": [
        {
          "command": "mpy-studio.openFile",
          "when": "view == mpy-studio.deviceFs && (viewItem == file || viewItem == python || viewItem == image)",
          "group": "navigation"
        },
        {
          "command": "mpy-studio.deleteFile",
          "when": "view == mpy-studio.deviceFs && (viewItem == file || viewItem == python || viewItem == image)",
          "group": "2_modification"
        },
        {
          "command": "mpy-studio.downloadFile",
          "when": "view == mpy-studio.deviceFs && (viewItem == file || viewItem == python || viewItem == image)",
          "group": "2_modification"
        },
        {
          "command": "mpy-studio.deleteFile",
          "when": "view == mpy-studio.deviceFs && viewItem == folder",
          "group": "2_modification"
        },
        {
          "command": "mpy-studio.downloadFile",
          "when": "view == mpy-studio.deviceFs && viewItem == folder",
          "group": "2_modification"
        }
      ],
      "view/title": [
        {
          "command": "mpy-studio.refreshDevice",
          "when": "view == mpy-studio.deviceFs",
          "group": "navigation@0",
          "icon": {
            "light": "media/refresh.svg",
            "dark": "media/refresh.svg"
          },
          "title": "刷新设备目录"
        },
        {
          "command": "mpy-studio.createFolder",
          "when": "view == mpy-studio.deviceFs",
          "group": "navigation@2",
          "icon": {
            "light": "media/new-folder.svg",
            "dark": "media/new-folder.svg"
          },
          "title": "新建文件夹"
        },
        {
          "command": "mpy-studio.createFile",
          "when": "view == mpy-studio.deviceFs",
          "group": "navigation@1",
          "icon": {
            "light": "media/new-file.svg",
            "dark": "media/new-file.svg"
          },
          "title": "新建文件"
        }
      ]
    },
    "configuration": {
      "title": "mpy-studio",
      "properties": {
        "micropython.port": {
          "type": "string",
          "default": "",
          "description": "串口设备路径"
        },
        "micropython.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "启动时自动连接设备"
        },
        "micropython.repl.escapeNonPrintable": {
          "type": "boolean",
          "default": false,
          "description": "将非打印字符显示为十六进制代码"
        },
        "micropython.repl.captureFile": {
          "type": "string",
          "default": "",
          "description": "REPL 会话输出捕获文件路径"
        },
        "micropython.repl.injectCode": {
          "type": "string",
          "default": "",
          "description": "按下 Ctrl-J 时注入的代码"
        },
        "micropython.repl.injectFile": {
          "type": "string",
          "default": "",
          "description": "按下 Ctrl-K 时注入的文件路径"
        },
        "micropython.stubPath": {
          "type": "string",
          "default": "",
          "description": "MicroPython stubs 文件路径"
        },
        "micropython.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径"
        },
        "micropython.autoDownloadStubs": {
          "type": "boolean",
          "default": true,
          "description": "自动下载并安装 MicroPython stubs"
        },
        "micropython.board": {
          "type": "string",
          "enum": [
            "esp32",
            "esp8266",
            "pyboard",
            "rp2040"
          ],
          "default": "esp32",
          "description": "MicroPython 开发板类型"
        },
        "mpy-studio.pureRepl.baudRate": {
          "type": "number",
          "default": 115200,
          "description": "纯REPL模式波特率"
        },
        "mpy-studio.pureRepl.timeout": {
          "type": "number",
          "default": 2000,
          "description": "纯REPL模式超时时间(毫秒)"
        },
        "mpy-studio.pureRepl.retryCount": {
          "type": "number",
          "default": 2,
          "description": "纯REPL模式重试次数"
        },
        "mpy-studio.pureRepl.commandDelay": {
          "type": "number",
          "default": 300,
          "description": "纯REPL模式命令延迟(毫秒)"
        },
        "mpy-studio.showDebugInfo": {
          "type": "boolean",
          "default": false,
          "description": "是否显示调试信息"
        },
        "mpy-studio.selectedBoard": {
          "type": "string",
          "default": "",
          "description": "用户选择的开发板（内部使用，请通过命令选择）"
        }
      }
    },
    "languages": [
      {
        "id": "python",
        "extensions": [
          ".py",
          ".pyi"
        ],
        "aliases": [
          "Python",
          "python"
        ]
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "mpy-studio",
          "title": "MPY-REPL",
          "icon": "media/micropython-menu.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "mpy-studio.deviceFs",
          "name": "MPY-设备",
          "when": "mpyStudio.deviceConnected == true"
        }
      ],
      "mpy-studio": [
        {
          "type": "webview",
          "id": "mpy-studio.replPanel",
          "name": "MPY-REPL",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "prepackage": "npm install && npm run compile",
    "clean": "rimraf out/ || true",
    "compile": "npm run clean && tsc -p ./ && npm run copy-resources",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "echo 'Linting skipped'",
    "test": "echo 'Tests skipped'",
    "copy-resources": "node build.js",
    "verify": "node verify-build.js",
    "package": "npm run verify && vsce package --skip-license",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major",
    "start": "node --no-warnings ./out/extension.js"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.115",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.22.0",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@serialport/bindings-cpp": "^13.0.1",
    "@serialport/parser-readline": "^13.0.0",
    "fs-extra": "^11.3.0",
    "just": "^0.1.8",
    "serialport": "^13.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sheacoding/mpy-studio.git"
  },
  "homepage": "https://github.com/sheacoding/mpy-studio",
  "bugs": {
    "url": "https://github.com/sheacoding/mpy-studio/issues"
  },
  "author": {
    "name": "ericoding",
    "email": "sheacoding@gmail.com",
    "url": "https://github.com/sheacoding"
  },
  "contributors": [
    {
      "name": "bright",
      "email": "flashpf@qq.com",
      "url": "https://gitee.com/ai_mpy"
    }
  ],
  "keywords": [
    "micropython",
    "esp32",
    "esp32-s3",
    "repl",
    "python",
    "embedded",
    "iot"
  ],
  "baseContentUrl": "https://github.com/sheacoding/mpy-studio/raw/main",
  "baseImagesUrl": "https://github.com/sheacoding/mpy-studio/raw/main"
}
