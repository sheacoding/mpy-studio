{
  "name": "mpy-studio",
  "displayName": "mpy-studio",
  "description": "A comprehensive MicroPython IDE for ESP32 and ESP32-S3 development boards. Features device management, code execution, REPL terminal, and more.",
  "version": "0.0.6",
  "publisher": "bright",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.mpyMenu",
        "title": "MicroPython",
        "icon": {
          "light": "media/light/micropython-menu.svg",
          "dark": "media/dark/micropython-menu.svg"
        }
      },
      {
        "command": "extension.mpyRUN",
        "title": "运行当前文件",
        "icon": "$(play)"
      },
      {
        "command": "extension.mpyStop",
        "title": "停止当前程序",
        "icon": "$(debug-stop)"
      },
      {
        "command": "extension.mpyREPL",
        "title": "REPL终端",
        "icon": "$(terminal)"
      },
      {
        "command": "extension.mpyMAIN",
        "title": "上传为主程序",
        "icon": "$(arrow-up)"
      },
      {
        "command": "extension.mpyHardReset",
        "title": "硬重启设备",
        "icon": "$(debug-restart)"
      },
      {
        "command": "extension.mpySelectPort",
        "title": "选择串口",
        "icon": "$(plug)"
      },
      {
        "command": "extension.mpyDisconnect",
        "title": "断开连接",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "extension.mpyShowLogs",
        "title": "显示插件日志",
        "icon": "$(output)"
      },
      {
        "command": "extension.mpyClear",
        "title": "清除主程序",
        "icon": "$(clear-all)"
      },
      {
        "command": "extension.updateTypings",
        "title": "更新 MicroPython 类型定义",
        "icon": "$(sync)"
      },
      {
        "command": "extension.selectBoard",
        "title": "选择开发板",
        "icon": "$(device-desktop)"
      },
      {
        "command": "extension.switchRunMode",
        "title": "切换运行模式"
      }
    ],
    "submenus": [
      {
        "id": "micropythonMenu.submenu",
        "label": "MicroPython菜单",
        "icon": {
          "light": "media/light/micropython-menu.svg",
          "dark": "media/dark/micropython-menu.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "micropythonMenu.submenu",
          "group": "navigation@4",
          "when": "resourceLangId == python"
        }
      ],
      "micropythonMenu.submenu": [
        {
          "command": "extension.mpyRUN",
          "group": "1_run@1",
          "icon": "$(play)"
        },
        {
          "command": "extension.mpyStop",
          "group": "1_run@2",
          "icon": "$(debug-stop)"
        },
        {
          "command": "extension.mpyMAIN",
          "group": "2_send",
          "icon": "$(arrow-up)"
        },
        {
          "command": "extension.mpyHardReset",
          "group": "2_send",
          "icon": "$(debug-restart)"
        },
        {
          "command": "extension.mpyREPL",
          "group": "3_repl",
          "icon": "$(terminal)"
        },
        {
          "command": "extension.mpyClear",
          "group": "4_clear",
          "icon": "$(clear-all)"
        },
        {
          "command": "extension.mpyDisconnect",
          "group": "5_disconnect",
          "icon": "$(debug-disconnect)"
        },
        {
          "command": "extension.mpyShowLogs",
          "group": "8_logs",
          "icon": "$(output)"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.mpyMenu",
          "when": "resourceLangId == python"
        },
        {
          "command": "extension.mpyREPL",
          "when": "resourceLangId == python"
        }
      ]
    },
    "configuration": {
      "title": "MicroPython Studio",
      "properties": {
        "micropython.port": {
          "type": "string",
          "default": "",
          "description": "串口设备路径"
        },
        "micropython.autoConnect": {
          "type": "boolean",
          "default": false,
          "description": "启动时自动连接设备"
        },
        "micropython.repl.escapeNonPrintable": {
          "type": "boolean",
          "default": false,
          "description": "将非打印字符显示为十六进制代码"
        },
        "micropython.repl.captureFile": {
          "type": "string",
          "default": "",
          "description": "REPL 会话输出捕获文件路径"
        },
        "micropython.repl.injectCode": {
          "type": "string",
          "default": "",
          "description": "按下 Ctrl-J 时注入的代码"
        },
        "micropython.repl.injectFile": {
          "type": "string",
          "default": "",
          "description": "按下 Ctrl-K 时注入的文件路径"
        },
        "micropython.stubPath": {
          "type": "string",
          "default": "",
          "description": "MicroPython stubs 文件路径"
        },
        "micropython.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python 解释器路径"
        },
        "micropython.autoDownloadStubs": {
          "type": "boolean",
          "default": true,
          "description": "自动下载并安装 MicroPython stubs"
        },
        "micropython.board": {
          "type": "string",
          "enum": [
            "esp32",
            "esp8266",
            "pyboard",
            "rp2040"
          ],
          "default": "esp32",
          "description": "MicroPython 开发板类型"
        },
        "mpy-studio.pureRepl.baudRate": {
          "type": "number",
          "default": 115200,
          "description": "纯REPL模式波特率"
        },
        "mpy-studio.pureRepl.timeout": {
          "type": "number",
          "default": 2000,
          "description": "纯REPL模式超时时间(毫秒)"
        },
        "mpy-studio.pureRepl.retryCount": {
          "type": "number",
          "default": 2,
          "description": "纯REPL模式重试次数"
        },
        "mpy-studio.pureRepl.commandDelay": {
          "type": "number",
          "default": 300,
          "description": "纯REPL模式命令延迟(毫秒)"
        },
        "mpy-studio.showDebugInfo": {
          "type": "boolean",
          "default": false,
          "description": "是否显示调试信息"
        },
        "my-studio.selectedBoard": {
          "type": "string",
          "default": "",
          "description": "用户选择的开发板（内部使用，请通过命令选择）"
        }
      }
    },
    "languages": [
      {
        "id": "python",
        "extensions": [
          ".py",
          ".pyi"
        ],
        "aliases": [
          "Python",
          "python"
        ]
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "mpy-studio",
          "title": "MPY-REPL",
          "icon": "media/micropython-menu.svg"
        }
      ]
    },
    "views": {
      "mpy-studio": [
        {
          "type": "webview",
          "id": "mpy-studio.replPanel",
          "name": "MPY-REPL"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "clean": "rm -rf out/",
    "compile": "npm run clean && tsc -p ./ && npm run copy-resources",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "copy-resources": "mkdir -p out/media && cp -r media/* out/media/ && mkdir -p out/typings && cp -r typings/* out/typings/ && mkdir -p out/resources && npx copyfiles -u 1 resources/**/* out/resources",
    "postbuild": "npx copyfiles -u 1 resources/**/* out/resources",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major"
  },

  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.111",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.4",
    "@vscode/test-electron": "^2.3.8",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@serialport/bindings-cpp": "^12.0.1",
    "about-window": "^1.15.2",
    "fs-extra": "^11.3.0",
    "iconv-lite": "^0.6.3",
    "micropython.js": "github:arduino/micropython.js#v1.5.1",
    "serialport": "^12.0.0",
    "vscode-languageclient": "^8.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/ai_mpy/mpy-studio.git"
  },
  "homepage": "https://gitee.com/ai_mpy/mpy-studio",
  "bugs": {
    "url": "https://gitee.com/ai_mpy/mpy-studio/issues"
  },
  "keywords": [
    "micropython",
    "esp32",
    "esp32-s3",
    "repl",
    "python",
    "embedded",
    "iot"
  ],
  "baseContentUrl": "https://gitee.com/ai_mpy/mpy-studio/raw/main",
  "baseImagesUrl": "https://gitee.com/ai_mpy/mpy-studio/raw/main"
}
